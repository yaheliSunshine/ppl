
(define make-ok
  (lambda (val)
    (cons "ok" val)
  )
 )
 
(define make-error
  (lambda (msg)
    (cons "error" msg)
  )
 )

(define ok?
  (lambda (res)
    (if (pair? res)
      (if (string? (car res))
        (if (string=? (car res) "ok")
          #t
          #f
          )
        #f
      )
      #f
    )
  )
)

(define error?
  (lambda (res)
    (if (pair? res)
      (if (string? (car res))
        (if (string=? (car res) "error")
          #t
          #f
          )
        #f
      )
      #f
    )
  )
 )

(define result?
  (lambda (res)
    (if (pair? res)
      (if (string? (car res))
        (if (string=? (car res) "ok")
          #t
          (if (string=? (car res) "error")
            #t
            #f
          )
        )
        #f
      )
      #f
    )
  )
)

(define result->val
  (lambda (res)
    (cdr res)
  )
)

(define bind 
  (lambda (f)
    (lambda (x)
      (if (ok? x)
        (f (result->val x))
        (if (error? x)
          x
          (make-error "Input is not of result type")
        )
      )
    )
  )
)


(define make-dict
  (lambda ()
     '()
  )
)


(define dict?
  (lambda (e)
   (if(empty? e)
    #t
      (if(pair? (car e))
      (dict? (cdr e))
      #f
      )
   )
  )
)


(define get
  (lambda (dict k)
    (if (dict? dict)
      (if (empty? dict)
        (make-error "Key not found")                 
        (if (equal? (car (car dict)) k)
            (make-ok (cdr (car dict)))
            (get (cdr dict) k)
        )  
      )
      (make-error "Error: not a dictionary")
    )
  )
)



(define put
  (lambda (dict k v)
    (if(dict? dict)
     (make-ok (cons (cons k v) (putExt dict k v)))
     (make-error "Error: not a dictionary")
     )
  )
)



(define putExt
   (lambda (dict k v)
        (if(empty? dict)
          '()
          (if(equal? (car (car dict)) k)
            (remove dict k)
            (cons (car  dict) (putExt(cdr  dict)))
          )
        )  
   ) 
) 


(define remove     
  (lambda (dict k)
    (if(eq?  dict '())
       dict
      (if(equal? (car (car  dict)) k)
        (cdr  dict)
        (cons (car dict) (remove (cdr  dict) k))
      )
    )
  )
)

(define equal? 
  (lambda (x y)
    (if (= x y)
      #t
      (if (string=? x y)
        #t
        (if (eq? x y)
          #t
          #f
        )
      )
    )
  )
)

(define map-dict
  (lambda (dict f)
    (if (dict? dict)
      (make-ok (recurive-map-dict dict f))
      (make-error "Error: Not a dictionary")
    )
  )
)

(define recurive-map-dict
  (lambda (dict f)
    (if (empty? dict)
      '()
      (cons (cons (car (car dict)) (f(cdr(car dict)))) (recurive-map-dict (cdr dict) f)))
  )
)

(define filter-dict
  (lambda (dict pred)
    (if (dict? dict)
      (make-ok (recursive-filter-dict dict pred))
      (make-error ("Error: Not a dictionary"))
    )
  )
)

(define recursive-filter-dict
  (lambda (dict pred)
    (if (empty? dict)
      '()
      (if (pred (car (car dict)) (cdr (car dict)))
        (cons (car dict) (recursive-filter-dict (cdr dict) pred))
        (recursive-filter-dict (cdr dict) pred)
      )
    )
  )
)
